# Local development only. Never commit real credentials.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/iremehub_dev?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7
FRONTEND_URL=http://localhost:3000
# Optional: configure a media provider when media uploads are implemented.
